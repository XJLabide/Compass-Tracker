NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-local-service-role-key-for-account-deletion

# Configure only after Google OAuth credentials exist for the relevant environment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Calendar uses a separate, explicitly consented read-only OAuth flow.
# Add the exact redirect URI to the Google OAuth client and enable the Calendar API.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# Generate with: openssl rand -hex 32
GOOGLE_CALENDAR_ENCRYPTION_KEY=
